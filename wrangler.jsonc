{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simonecolabufalo",
  "compatibility_date": "2026-09-03",

  // Nuxt Content is resolved during generation; this Worker only serves files.
  "assets": {
    "directory": "./.output/public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },

  "routes": [
    { "pattern": "simonecolabufalo.com", "custom_domain": true },
    { "pattern": "www.simonecolabufalo.com", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": true,
}
